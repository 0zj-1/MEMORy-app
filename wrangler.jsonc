{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memory-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "kv_namespaces": [{ "binding": "USAGE", "id": "de810ea572ef4d7184f4cfd91d872b3c" }],
  "ratelimits": [
    { "name": "BURST", "namespace_id": "20261105", "simple": { "limit": 3, "period": 60 } }
  ],
  "vars": {
    "AI_ENABLED": "true",
    "IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-4b",
    "TEXT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "DAILY_LIMIT": "40",
    "IP_DAILY_LIMIT": "10"
  }
}
